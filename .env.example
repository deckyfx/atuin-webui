# ─── Which client the dashboard drives ────────────────────────────────────
# sandbox = throwaway client in ./sandbox  (safe default)
# live    = this machine's real atuin client
ATUIN_PROFILE=sandbox

# ─── Dashboard ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Sync-server admin views (optional) ───────────────────────────────────
# The server DB is E2E-encrypted: it yields users/sessions/record counts,
# never command text. Legacy name ATUIN_DB_PATH still works.
#ATUIN_SERVER_DB_PATH=/path/to/atuin-server/atuin.db

# ─── Client paths (optional) ──────────────────────────────────────────────
# Defaults follow ATUIN_PROFILE; override only for a non-standard layout.
#ATUIN_CLIENT_DATA_DIR=/home/you/.local/share/atuin
#ATUIN_CLIENT_CONFIG_DIR=/home/you/.config/atuin

# ─── Bootstrap credentials (optional) ─────────────────────────────────────
# ONLY needed to log in a client that never has -- a fresh container, or the
# sandbox. Once meta.db holds a `session` token, sync needs none of this.
# On this machine the live client is already logged in: leave these unset.
#ATUIN_SYNC_ADDRESS=http://192.168.0.102:5023
#ATUIN_USERNAME=

# Password is used once at login and never again. Prefer typing it into a
# one-off `atuin login` over storing it here.
#ATUIN_PASSWORD=

# The bip39 key. Prefer KEY_FILE: it stays 0600 and outside the repo.
# The live client's key already exists at the path below -- point at it
# rather than pasting the mnemonic anywhere.
#ATUIN_KEY_FILE=/home/you/.local/share/atuin/key
# Inline mnemonic. Container-bootstrap fallback only; never commit it.
#ATUIN_KEY=

# Listen address. Loopback by default: every endpoint is unauthenticated.
# Set 0.0.0.0 only behind authentication or a trusted reverse proxy.
#HOST=127.0.0.1
