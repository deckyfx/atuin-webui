{
  "name": "atuin-dashboard",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun run scripts/embed-migrations.ts && bun run typecheck && bun run build.ts",
    "build:current": "bun run scripts/embed-migrations.ts && bun run typecheck && bun run build.ts --current",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "review": "coderabbit review",
    "review:agent": "coderabbit review --agent",
    "review:pr": "coderabbit pullrequest"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
