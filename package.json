{
  "name": "atuin-dashboard",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun run scripts/embed-migrations.ts && bun run typecheck && bun run build.ts",
    "build:current": "bun run scripts/embed-migrations.ts && bun run typecheck && bun run build.ts --current",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "lucide-react": "^1.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^7"
  }
}
